rules_version = '2';

// SkinAid — Firestore аюулгүй байдлын дүрэм
// Нийтлэх: Firebase console → Firestore Database → Rules → энэ файлыг буулгаад Publish
// (эсвэл `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Туслах функцууд ----------
    // Admin = Google-ээр нэвтэрсэн, и-мэйл нь баталгаажсан, доорх жагсаалтад байгаа.
    // Шинэ admin нэмэх: и-мэйлийг энд нэмээд дүрмийг дахин Publish хийнэ.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['hello@skinaid.mn', 'info@skinaid.mn'];
    }
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function incoming() { return request.resource.data; }
    // settings/home (admin «Нүүр хуудас»). АНХААР: Firestore дүрэм нэг хүсэлтэд ≤ 1000 илэрхийлэл үнэлнэ. Талбар бүрийн
    // урт/төрлийг шалгадаг байсан хувилбар 3 карт + 3 статистиктай үед ч хязгаараас хэтэрч, хадгалалт бүр «Эрх хүрэхгүй»
    // (permission-denied) болж байсан (2026-11-26). Иймд энд зөвхөн бүтэц + зураг/холбоосын схем (XSS-ийн 2-р давхарга);
    // урт, төрөл, escape — assets/js/home-render.js norm() (сайт, admin, build бүгд Firestore-ийн утгыг norm()-оор дамжуулна).
    // Шинэ шалгалт нэмэхдээ 12 карттай хамгийн муу тохиолдлыг бод (карт бүрийн функц 12 удаа үнэлэгдэнэ).
    function validHero(h) {
      return h is map
        && h.keys().hasOnly(['badge', 'titlePre', 'titleEm', 'titlePost', 'text', 'btnPrimary', 'btnSecondary', 'stats'])
        && h.get('stats', []) is list && h.get('stats', []).size() <= 3;
    }
    // «Зөвлөгөө» карт (settings/home.posts[i]). Зураг: сайтын assets/img/photos/… эсвэл https://; холбоос: https:// эсвэл
    // сайтын /зам (//host, зай/tab биш). Нарийн шүүлт (\\, ' г.м., escape, хост, урт) home-render.js norm()-д.
    function validPost(p) {
      return p is map
        && p.keys().hasOnly(['id', 'cat', 'title', 'text', 'by', 'img', 'url', 'hidden'])
        && p.get('img', '').matches('^(https://[^[:space:]"<>]+|assets/img/photos/[A-Za-z0-9._-]+([?]v=[0-9a-z]+)?)?$')
        && p.get('url', '').matches('^(https://[^[:space:]"<>]+|/([^/[:space:]][^[:space:]"<>]*)?)?$');
    }
    // List-ээр давталт хийх боломжгүй тул 12 байрлалыг тус тусад нь (size()-ээр богино холболттой)
    function validPosts(ps) {
      return ps is list && ps.size() <= 12
        && (ps.size() < 1 || validPost(ps[0]))
        && (ps.size() < 2 || validPost(ps[1]))
        && (ps.size() < 3 || validPost(ps[2]))
        && (ps.size() < 4 || validPost(ps[3]))
        && (ps.size() < 5 || validPost(ps[4]))
        && (ps.size() < 6 || validPost(ps[5]))
        && (ps.size() < 7 || validPost(ps[6]))
        && (ps.size() < 8 || validPost(ps[7]))
        && (ps.size() < 9 || validPost(ps[8]))
        && (ps.size() < 10 || validPost(ps[9]))
        && (ps.size() < 11 || validPost(ps[10]))
        && (ps.size() < 12 || validPost(ps[11]));
    }

    // ---------- Захиалга ----------
    match /bookings/{id} {
      // Хэн ч үүсгэж болно, гэхдээ яг энэ бүтэцтэй, хязгаартай өгөгдөл л орно.
      allow create: if
        incoming().keys().hasOnly(['name', 'phone', 'service', 'date', 'message', 'status', 'source', 'createdAt'])
        && incoming().keys().hasAll(['name', 'phone', 'service', 'date', 'message', 'status', 'source', 'createdAt'])
        && isStr(incoming().name, 2, 80)
        && incoming().name.trim().size() >= 2
        && isStr(incoming().phone, 8, 20)
        && incoming().phone.matches('^[-0-9+ ]+$')
        && incoming().phone.replace('[^0-9]', '').size() >= 8
        && isStr(incoming()['service'], 1, 120)   // 'service' нь Rules хэлний түлхүүр үг тул [] хэлбэрээр
        && isStr(incoming().date, 0, 10)
        && (incoming().date == '' || incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && isStr(incoming().message, 0, 1000)
        && incoming().status == 'new'
        && incoming().source == 'web'
        && incoming().createdAt == request.time;

      // Унших, устгах — зөвхөн admin
      allow read, delete: if isAdmin();

      // Засах — зөвхөн admin, зөвхөн статус/тэмдэглэл (үйлчлүүлэгчийн өгөгдөл хөдлөхгүй)
      allow update: if isAdmin()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt', 'updatedBy'])
        && incoming().status in ['new', 'contacted', 'confirmed', 'cancelled']
        && isStr(incoming().get('note', ''), 0, 1000)
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.token.email;
    }

    // Нийтийн хуудсын текст, зураг, холбоосын өөрчлөлт. Зөвшөөрсөн талбарт л renderer хэрэглэнэ.
    match /public_content/{page} {
      allow get: if true;
      allow create, update: if isAdmin()
        && page.matches('^[a-z0-9~-]{1,100}$')
        && incoming().keys().hasOnly(['values', 'updatedAt'])
        && isStr(incoming().values, 2, 80000)
        && incoming().updatedAt == request.time;
    }

    // ---------- Тохиргоо (сайт уншина, admin бичнэ) ----------
    match /settings/{doc} {
      allow read: if true;

      allow write: if isAdmin()
        && doc in ['site', 'catalog', 'home']
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.token.email
        && (
          (doc == 'site'
            && incoming().keys().hasOnly(['hours', 'phone', 'email', 'promoEnabled', 'bookingEnabled', 'updatedAt', 'updatedBy'])
            && isStr(incoming().get('hours', ''), 0, 300)
            && isStr(incoming().get('phone', ''), 0, 30)
            && isStr(incoming().get('email', ''), 0, 80)
            && incoming().get('promoEnabled', false) is bool
            && incoming().get('bookingEnabled', false) is bool)
          ||
          (doc == 'catalog'
            && incoming().keys().hasOnly(['services', 'packages', 'updatedAt', 'updatedBy'])
            && incoming().services is list && incoming().services.size() <= 200
            && incoming().packages is list && incoming().packages.size() <= 30)
          ||
          // Нүүрний hero + «Зөвлөгөө» картууд (admin «Нүүр хуудас»). baseRev = admin хадгалах үеийн repo-ийн
          // content/home.json-ийн хувилбар (main.js: repo шинэ бол давхарлахгүй).
          (doc == 'home'
            && incoming().keys().hasOnly(['hero', 'posts', 'baseRev', 'updatedAt', 'updatedBy'])
            && validHero(incoming().get('hero', null))
            && validPosts(incoming().get('posts', null))
            && isStr(incoming().get('baseRev', ''), 0, 40))
        );
    }

    // ---------- Messenger AI (сүүдэр: ноорог л; «Автомат»: зөвшөөрсөн сэдэвт сервер шууд хариулна) ----------
    // Сервер (Vercel функц, api/) Google-ийн service account-аар (IAM, WIF) бичдэг — энэ дүрэм серверт ХАМААРАХГҮЙ.
    // Admin (client) бичих эрх ЗӨВХӨН: тохиргоо (+ нэг batch-д audit), мэдлэг/жишээ (2-р үе шат), ноорогийн үнэлгээ.
    // Хязгаар = api/_lib/social/settings-logic.js, labels.js (tools/test/messenger-rules.test.mjs тулгана).
    function messengerAudit(id) {
      return getAfter(/databases/$(database)/documents/messenger_audit/$(id)).data;
    }
    function messengerSettingsAfter() {
      return getAfter(/databases/$(database)/documents/messenger_settings/main).data;
    }
    // «Автомат» горимын туршилтын акаунт (testThreads): ярианы id-ийн жагсаалт, ≤ 10. ЭНД ЗӨВХӨН БҮТЭЦ (жагсаалт, тоо) —
    // элемент бүрийн хэлбэрийг (64 hex) сервер (api/_lib/social/settings-logic.js normalizeSettings) ба admin шүүнэ: буруу
    // элемент ямар ч яриатай таарахгүй (хэнд ч илгээхгүй). Firestore дүрэм нэг хүсэлтэд ≤ 1000 илэрхийлэл үнэлдэг тул
    // элемент бүрийг дүрэмд шалгавал (10 × regex) тохиргоо + audit-ийн хадгалалт «Эрх хүрэхгүй» болох эрсдэлтэй
    // (settings/home-д ийм болсон, 2026-11-26) — «Яаралтай зогсоох» хадгалагдахгүй болно.
    function validTestThreads(l) {
      return l is list && l.size() <= 10;
    }

    match /messenger_settings/{doc} {
      allow read: if isAdmin();
      // Өөрчлөлт бүр ижил batch-д шинэ audit мөртэй (lastAuditId → messenger_audit, at == request.time).
      // autoAudience, testThreads — «Автомат» горимын үзэгчид; ЗААВАЛ БИШ (байхгүй = 'test', хоосон жагсаалт: хэнд ч илгээхгүй).
      allow create, update: if isAdmin()
        && doc == 'main'
        && incoming().keys().hasOnly(['mode', 'killSwitch', 'monthlyRunCap', 'monthlyCostCapUsd', 'autoAudience', 'testThreads', 'lastAuditId', 'updatedAt', 'updatedBy'])
        && incoming().keys().hasAll(['mode', 'killSwitch', 'monthlyRunCap', 'monthlyCostCapUsd', 'lastAuditId', 'updatedAt', 'updatedBy'])
        && incoming().mode in ['off', 'shadow', 'auto']
        && incoming().get('autoAudience', 'test') in ['test', 'all']
        && validTestThreads(incoming().get('testThreads', []))
        && incoming().killSwitch is bool
        && incoming().monthlyRunCap is int && incoming().monthlyRunCap >= 0 && incoming().monthlyRunCap <= 100000
        && incoming().monthlyCostCapUsd is number && incoming().monthlyCostCapUsd >= 0 && incoming().monthlyCostCapUsd <= 1000
        && isStr(incoming().lastAuditId, 8, 64) && incoming().lastAuditId.matches('^[A-Za-z0-9_-]+$')
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.token.email
        && messengerAudit(incoming().lastAuditId).at == request.time
        && messengerAudit(incoming().lastAuditId).action == 'settings';
      allow delete: if false;
    }

    // Append-only: зөвхөн үүсгэнэ (засах, устгах хориотой); тохиргооны өөрчлөлттэй нэг batch-д л
    match /messenger_audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['action', 'by', 'at', 'detail'])
        && incoming().keys().hasAll(['action', 'by', 'at', 'detail'])
        && incoming().action == 'settings'
        && incoming().by == request.auth.token.email
        && incoming().at == request.time
        && incoming().detail is map
        && incoming().detail.keys().hasOnly(['mode', 'killSwitch', 'monthlyRunCap', 'monthlyCostCapUsd', 'autoAudience', 'testThreads'])
        && messengerSettingsAfter().lastAuditId == id
        && incoming().detail.get('mode', '') == messengerSettingsAfter().mode
        && incoming().detail.get('killSwitch', null) == messengerSettingsAfter().killSwitch
        && incoming().detail.get('monthlyRunCap', -1) == messengerSettingsAfter().monthlyRunCap
        && incoming().detail.get('monthlyCostCapUsd', -1) == messengerSettingsAfter().monthlyCostCapUsd
        && incoming().detail.get('autoAudience', 'test') == messengerSettingsAfter().get('autoAudience', 'test')
        && incoming().detail.get('testThreads', []) == messengerSettingsAfter().get('testThreads', []);
      allow update, delete: if false;
    }

    // Мэдлэг, жишээ (2-р үе шатны «Сургалт» UI) — admin бичнэ
    match /messenger_kb/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && incoming().keys().hasOnly(['title', 'body', 'status', 'updatedAt', 'updatedBy'])
        && isStr(incoming().get('title', ''), 1, 120)
        && isStr(incoming().get('body', ''), 1, 4000)
        && incoming().get('status', '') in ['draft', 'published']
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }
    match /messenger_examples/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && incoming().keys().hasOnly(['userText', 'reply', 'kind', 'note', 'updatedAt', 'updatedBy'])
        && isStr(incoming().get('userText', ''), 1, 2000)
        && isStr(incoming().get('reply', ''), 0, 2000)
        && incoming().get('kind', '') in ['good', 'bad']
        && isStr(incoming().get('note', ''), 0, 500)
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // Ноорог: сервер үүсгэнэ; admin ЗӨВХӨН үнэлгээ (rating/note/ratedAt/ratedBy). «Засвартай» = зөв хариуг заавал бичнэ.
    match /messenger_drafts/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['rating', 'note', 'ratedAt', 'ratedBy'])
        && incoming().rating in ['good', 'edited', 'wrong']
        && isStr(incoming().note, 0, 2000)
        && (incoming().rating != 'edited' || incoming().note.trim().size() >= 2)
        && incoming().ratedAt == request.time
        && incoming().ratedBy == request.auth.token.email;
      allow create, delete: if false;
    }

    // Зөвхөн сервер бичнэ (admin уншина)
    match /messenger_threads/{id} {
      allow read: if isAdmin();
      allow write: if false;
      match /messages/{mid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /messenger_events/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /ai_runs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /messenger_usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /messenger_status/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /messenger_echo_templates/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // «Автомат» горимд үйлчлүүлэгч рүү илгээсэн мессежийн бүртгэл — зөвхөн сервер бичнэ (api/_lib/outbound.js)
    match /messenger_outbound/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Бусад бүх зам: хориотой
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
