{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "destination": "https://www.skinaid.mn/:path",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "skinaidgithubio-y1vf.vercel.app"
        }
      ]
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:dir(.+)/index.html",
      "destination": "/:dir",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/book-online",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/book-online/:rest*",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/booking-calendar/:rest*",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/#blog",
      "permanent": false
    },
    {
      "source": "/blog/:rest*",
      "destination": "/#blog",
      "permanent": false
    },
    {
      "source": "/service-page/:rest*",
      "destination": "/#treatments",
      "permanent": false
    },
    {
      "source": "/post/:rest*",
      "destination": "/#blog",
      "permanent": false
    },
    {
      "source": "/product-page/:rest*",
      "destination": "/",
      "permanent": false
    }
  ]
}
